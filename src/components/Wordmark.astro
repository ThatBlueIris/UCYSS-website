---
/**
 * The real UCYSS mark.
 *
 * This replaces the interim identity described in PLAN.md §3.2 — the
 * hand-drawn shield and the typed-out "UCYSS" lockup are both gone. The
 * component is now a thin wrapper around one file, so the mark can be
 * re-exported from the designers at any resolution without touching a
 * call site.
 *
 * The mark is a square seal that fills its canvas, so one dimension drives
 * both axes. `sm` is chrome (header, footer); `lg` is editorial display
 * (the About masthead).
 */
interface Props {
	/** Compact mark for page chrome, or the full seal for display. */
	size?: "sm" | "lg";
	/** Passthrough onto the root element, for positioning. */
	class?: string;
	/**
	 * Empty by default: the mark almost always sits beside a text lockup or
	 * inside a link that already carries the name, so it is decorative there.
	 * Pass a string when the image is the only thing conveying the identity.
	 */
	alt?: string;
}

const { size = "sm", class: className = "", alt = "" } = Astro.props;

const dimensions = {
	sm: "h-9 w-9",
	lg: "h-24 w-24 sm:h-28 sm:w-28",
};
---

<img
	src="/logos/ucyss-formal.png"
	alt={alt}
	width="320"
	height="320"
	decoding="async"
	class:list={["object-contain", dimensions[size], className]}
/>
