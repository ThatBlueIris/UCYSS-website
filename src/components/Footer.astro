---
/**
 * Footer. Carries the institutional lockup — borrowed credibility, which
 * answers "are these people real?" for a first-time visitor (PLAN.md §1.2).
 *
 * The UPTM / FCOM / Pixora marks are displayed as supplied. They are three
 * separate organisations' artwork in three different colour schemes, so they
 * sit at low opacity and a fixed optical height: present, legible as
 * institutions, never competing with the UCYSS mark.
 */
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();

/* Widths chosen so each mark's *visible* height lands at 30–35px. Pixora's
   canvas carries a lot of transparent padding, so it needs a much wider box
   to end up the same size as the other two. */
const umbrella = [
	{ src: "/logos/uptm.png", alt: "Universiti Poly-Tech Malaysia", width: 78, natural: "320x143" },
	{ src: "/logos/fcom.png", alt: "Faculty of Computing and Multimedia, UPTM", width: 78, natural: "320x125" },
	{ src: "/logos/pixora.png", alt: "Pixora Society Club, FCOM", width: 51, natural: "320x320" },
];

const columns = [
	{
		title: "The site",
		links: [
			{ href: "/about", label: "About UCYSS" },
			{ href: "/what-we-do", label: "What we do" },
			{ href: "/events", label: "Events" },
			{ href: "/writeups", label: "Writeups" },
		],
	},
	{
		title: "Take part",
		links: [
			{ href: "/join", label: "Join UCYSS" },
			{ href: "/gallery", label: "Gallery" },
			{ href: "/team", label: "Committee" },
			{ href: "/contact", label: "Contact" },
		],
	},
];
---

<footer class="border-t border-line">
	<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
		<div class="grid gap-12 md:grid-cols-12 md:gap-8">
			<div class="md:col-span-5">
				<a href="/" class="flex items-center gap-3.5" aria-label="UCYSS — home">
					<Wordmark />
					<span class="flex flex-col leading-none">
						<span class="text-xl font-semibold tracking-tight">UCYSS</span>
						<span class="label-mono mt-2 text-[0.5625rem] text-faint">
							Cybersecurity Student Society
						</span>
					</span>
				</a>
				<p class="mt-6 max-w-sm text-[0.9375rem] leading-relaxed text-muted">
					A student-led cybersecurity community. Capture-the-flag labs, digital
					forensics, OSINT, and writeups from the sessions we actually run.
				</p>
			</div>

			{
				columns.map((col, i) => (
					<nav
						aria-label={col.title}
						class:list={["md:col-span-3", i === 1 && "md:col-span-4 md:pl-10"]}
					>
						<p class="label-mono text-faint">{col.title}</p>
						<ul class="mt-5 space-y-1">
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="-mx-2 flex min-h-11 items-center px-2 text-sm text-muted transition-colors duration-200 hover:text-text"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<!-- Institutional hierarchy: the real marks, displayed as supplied. -->
		<div class="mt-14 border-t border-line pt-8 md:mt-20">
			<p class="label-mono text-faint">A focus group within</p>
			<ul class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-5">
				{
					umbrella.map((mark) => (
						<li class="opacity-45 transition-opacity duration-200 hover:opacity-80">
							<img
								src={mark.src}
								alt={mark.alt}
								width={mark.natural.split("x")[0]}
								height={mark.natural.split("x")[1]}
								loading="lazy"
								decoding="async"
								style={`width:${mark.width}px;height:auto`}
							/>
						</li>
					))
				}
			</ul>
			<p class="mt-5 max-w-xl text-sm leading-relaxed text-faint">
				Universiti Poly-Tech Malaysia &rarr; Faculty of Computing &amp; Multimedia
				&rarr; Pixora Society Club. UCYSS is a focus group inside Pixora, not a
				separate club.
			</p>
		</div>

		<div
			class="mt-10 flex flex-col gap-2 border-t border-line pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} UCYSS. Student-led, non-commercial.</p>
			<p class="font-mono">
				<a
					href="/privacy"
					class="inline-flex min-h-11 items-center transition-colors duration-200 hover:text-muted"
					>Privacy</a
				>
			</p>
		</div>
	</div>
</footer>
