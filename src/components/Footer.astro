---
/**
 * Footer. Carries the "under the umbrella of" lockup — borrowed institutional
 * credibility, which answers "are these people real?" for a first-time visitor
 * (PLAN.md §1.2).
 *
 * UPTM / FCOM / Pixora marks are TEXT ONLY until usage permission is granted.
 * Do not add the logo files without that permission.
 */
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();

const columns = [
	{
		title: "Explore",
		links: [
			{ href: "/about", label: "About" },
			{ href: "/what-we-do", label: "What We Do" },
			{ href: "/events", label: "Events" },
			{ href: "/writeups", label: "Writeups" },
		],
	},
	{
		title: "Community",
		links: [
			{ href: "/gallery", label: "Gallery" },
			{ href: "/team", label: "Team" },
			{ href: "/alumni", label: "Alumni" },
			{ href: "/join", label: "Join UCYSS" },
		],
	},
	{
		title: "More",
		links: [
			{ href: "/achievements", label: "Achievements" },
			{ href: "/partners", label: "Partners" },
			{ href: "/announcements", label: "Announcements" },
			{ href: "/contact", label: "Contact" },
		],
	},
];
---

<footer class="border-t border-line bg-surface">
	<div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-18">
		<div class="grid gap-12 md:grid-cols-4 md:gap-8">
			<div class="md:col-span-1">
				<Wordmark />
				<p class="mt-5 max-w-64 text-sm leading-relaxed text-muted">
					The cybersecurity community within Pixora, FCOM, UPTM.
				</p>
			</div>

			{
				columns.map((col) => (
					<div>
						<h2 class="label-mono text-faint">{col.title}</h2>
						<ul class="mt-4 space-y-2.5">
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-muted transition-colors duration-200 hover:text-teal"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<!-- Institutional hierarchy. Text-only pending logo permission. -->
		<div class="mt-14 border-t border-line-soft pt-8">
			<p class="label-mono text-faint">A community within</p>
			<p class="mt-3 text-sm text-muted">
				<span class="text-text">Pixora</span>, the official club of the
				<span class="text-text">Faculty of Computing &amp; Multimedia</span>,
				<span class="text-text">Universiti Poly-Tech Malaysia</span>.
			</p>
		</div>

		<div
			class="mt-8 flex flex-col gap-3 border-t border-line-soft pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} UCYSS. Student-led, non-commercial.</p>
			<p class="font-mono">
				<a href="/privacy" class="transition-colors hover:text-muted">Privacy</a>
			</p>
		</div>
	</div>
</footer>
