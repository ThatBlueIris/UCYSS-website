---
/**
 * The hero's right-hand column: what is happening next, and what has been on.
 *
 * The first two versions of this treated the panel as a record — a spine, a
 * date column, column headers, a "3 topics on record" count, and a note
 * explaining that no dates were on record. All of that was the wrong shape for
 * the data. Three topics with no date, presenter or note is a short list, not a
 * log, and a layout that announces itself as a table and then shows three bare
 * words beside an empty column always reads as unfinished.
 *
 * So this is not a record. It is an invitation, and the record is the footnote
 * to it. The panel leads with the one thing the society actually commits to —
 * Wednesday, because that is the habit — then the fact that the topic is open
 * and anyone may take it, then the three real topics as evidence the model
 * works. Nothing is dated, numbered, counted or annotated, because nothing in
 * `src/data/site.ts` supports any of those.
 *
 * Two deliberate omissions:
 *
 * 1. No calendar date. The correct next Wednesday is computable at build time,
 *    but the site is static and ships no JavaScript, so the number would be
 *    frozen at deploy and quietly wrong within a week. Printing the weekday
 *    instead is the only claim that stays true. PLAN.md §1.4 asks for the
 *    habit to be stated without implying an unbroken weekly record, and the
 *    skip caveat below does that.
 * 2. No "date to add" marker. The header of `src/data/site.ts` promises one,
 *    and the previous version shipped one. An empty field is now rendered by
 *    simply not rendering that field, so the gaps in the data are not part of
 *    the design. (Reconcile that note in `src/data/site.ts` when it is next
 *    edited — that file is out of this component's scope.)
 *
 * `date`, `presenter` and `note` still render the moment they are filled in, so
 * the panel gets richer as the record does without a redesign.
 *
 * Type scale: every mono label is `label-mono` at its own 11px — no size
 * override anywhere in this component. Sans is three steps only: the weekday,
 * the topic list, and one 14px supporting size.
 *
 * Zero JavaScript. No transitions except the link's underline colour, which the
 * global `prefers-reduced-motion` rule already collapses. Mobile-first: single
 * column at 375px, no horizontal overflow.
 */
import { sessions } from "../data/site";

interface Props {
	/** Names the panel. Sits above the weekday, not above the list. */
	heading?: string;
	/** One short line under the panel. */
	caption?: string;
}

const { heading = "Next session", caption } = Astro.props;

const MONTHS = [
	"Jan",
	"Feb",
	"Mar",
	"Apr",
	"May",
	"Jun",
	"Jul",
	"Aug",
	"Sep",
	"Oct",
	"Nov",
	"Dec",
];

/** ISO in, "28 Aug 2026" out. Anything unparseable is shown as written. */
const formatDate = (iso: string) => {
	const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
	if (!m) return iso;
	const month = MONTHS[Number(m[2]) - 1];
	if (!month) return iso;
	return `${Number(m[3])} ${month} ${m[1]}`;
};
---

<section aria-labelledby="session-log-heading">
	<h2 id="session-log-heading" class="label-mono text-accent">{heading}</h2>

	<!-- The habit, set as type. This is the largest thing in the column and
	     the only date claim the society actually makes. -->
	<div class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
		<p
			class="font-light leading-none text-text [font-size:clamp(1.875rem,1.4rem+2.2vw,2.375rem)] [letter-spacing:var(--tracking-display)]"
		>
			Wednesday
		</p>
		<p class="label-mono text-faint">usual meetup day</p>
	</div>

	<p class="mt-5 max-w-sm text-[0.875rem] leading-relaxed text-muted">
		The topic is open. Teach something you picked up in the last month, or just turn up
		and listen.
	</p>

	<!-- The honesty line. §1.4: the habit, not a guarantee. -->
	<p class="mt-3 max-w-sm text-[0.875rem] leading-relaxed text-faint">
		Weeks get skipped when nobody volunteers, and during finals.
	</p>

	<!-- The one thing to do in this column. White rather than teal: the accent
	     is already spent on this page's section labels, and a link underlined
	     in white is already unmistakable. Teal arrives on hover. -->
	<a
		href="/join"
		class="mt-7 inline-flex min-h-11 items-center gap-2 border-b border-line-strong pb-1 text-[0.875rem] font-medium text-text transition-colors duration-200 ease-out-soft hover:border-accent"
	>
		Join, and bring a topic <span aria-hidden="true">&rarr;</span>
	</a>

	<!-- The record, demoted to evidence. Hairline-separated rows, no metadata
	     unless it is real, no count. -->
	{
		sessions.length > 0 && (
			<div class="mt-12 border-t border-line pt-6">
				<h3 id="session-log-topics-heading" class="label-mono text-faint">
					Already taught
				</h3>
				<ol
					class="mt-4 border-t border-line"
					aria-labelledby="session-log-topics-heading"
				>
					{sessions.map((session) => (
						<li class="border-b border-line py-4">
							<p class="text-[1.0625rem] font-medium leading-[1.3] tracking-tight text-text sm:text-[1.1875rem]">
								{session.topic}
							</p>
							{session.date && (
								<p class="label-mono mt-2.5 text-faint">
									<time datetime={session.date}>{formatDate(session.date)}</time>
								</p>
							)}
							{session.presenter && (
								<p class="mt-1.5 text-[0.875rem] leading-relaxed text-muted">
									Taught by {session.presenter}
								</p>
							)}
							{session.note && (
								<p class="mt-1.5 max-w-sm text-[0.875rem] leading-relaxed text-muted">
									{session.note}
								</p>
							)}
						</li>
					))}
				</ol>
			</div>
		)
	}

	{
		caption && (
			<p class="mt-8 max-w-sm text-[0.875rem] leading-relaxed text-muted">
				{caption}
			</p>
		)
	}
</section>
