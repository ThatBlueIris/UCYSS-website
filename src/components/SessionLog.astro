---
/**
 * Session log — the hero's right-hand column.
 *
 * A record of what has actually been taught, read straight from
 * `src/data/site.ts`. It is deliberately not a boxed list with a header and
 * dividers (PLAN.md §3.4, §3.8): it hangs off a hairline spine, the way an
 * index in a field notebook does, with a column header that tells you what
 * each column is for.
 *
 * The design is built around the fact that date, presenter and note are all
 * empty for every entry in the current data set. The topic is the only thing
 * on this page that is definitely true, so it gets the type — sans, medium,
 * the largest thing in the column. Everything else is metadata, set small in
 * mono, and simply absent when nobody has recorded it. There are no invented
 * session numbers: a position in a list is not a session reference.
 *
 * The date column stays a real, labelled, fixed-width column even when it is
 * empty, because an empty column under a DATE header is a clearer statement
 * of "not on record" than a dashed box repeated on every row. The note under
 * the list then says so once, in plain words, instead of three times in caps.
 *
 * Zero JavaScript — a static <ol>. One transition, and the global
 * `prefers-reduced-motion` rule already collapses it. Mobile-first: one column
 * at 375px, no horizontal overflow.
 */
import { sessions } from "../data/site";

interface Props {
	/** States plainly what the list is. */
	heading?: string;
	/** One short line under the panel. */
	caption?: string;
}

const { heading = "Session log", caption } = Astro.props;

/* How many listed sessions have no date. Those rows get no date cell at all;
   the gap in the column is the marker. See the note below the list. */
const undated = sessions.filter((s) => !s.date).length;
const dateNote =
	undated === 0
		? null
		: undated === sessions.length
			? "no dates on record for these yet — they get added when someone confirms them."
			: undated === 1
				? "1 of these has no date on record yet."
				: `${undated} of these have no date on record yet.`;
---

<section aria-labelledby="session-log-heading">
	<!-- Open space, not a card. One hairline closes the header; the list is
	     hung off its own spine below. -->
	<div
		class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-line-strong pb-3"
	>
		<h2 id="session-log-heading" class="label-mono text-accent">{heading}</h2>
		{
			sessions.length > 0 && (
				<p class="label-mono text-[0.625rem] text-faint">
					{sessions.length} topics on record
				</p>
			)
		}
	</div>

	{
		sessions.length > 0 ? (
			<>
				{/* Column labels, wide screens only, so the two columns of the
				    record are legible as a record. Marked decorative: the list
				    underneath already carries the same information for a screen
				    reader, and this is a table head bolted onto an <ol>. */}
				<div
					class="hidden gap-x-6 border-b border-line py-2.5 md:grid md:grid-cols-[minmax(0,1fr)_6.5rem] md:pl-6"
					aria-hidden="true"
				>
					<span class="label-mono text-[0.625rem] text-faint">Topic</span>
					<span class="label-mono justify-self-end text-[0.625rem] text-faint">
						Date
					</span>
				</div>

				<ol class="border-b border-line-strong">
					{sessions.map((session) => (
						<li class="relative grid gap-x-6 gap-y-3 border-l border-line-strong py-5 pl-6 transition-colors duration-200 ease-out-soft hover:border-accent md:grid-cols-[minmax(0,1fr)_6.5rem] md:gap-y-0">
							{/* The node on the spine. A square, not a dot: these are
							    topics, not events, and there is no timeline here. */}
							<span
								class="absolute -left-[0.1875rem] top-[0.5625rem] size-1.5 bg-accent"
								aria-hidden="true"
							/>

							<div class="min-w-0">
								<p class="text-[1.0625rem] font-medium leading-[1.35] tracking-tight text-text sm:text-[1.125rem]">
									{session.topic}
								</p>
								{session.presenter && (
									<p class="label-mono mt-2.5 text-[0.625rem] text-faint">
										taught by {session.presenter}
									</p>
								)}
								{session.note && (
									<p class="mt-2.5 max-w-prose text-[0.875rem] leading-relaxed text-muted">
										{session.note}
									</p>
								)}
							</div>

							{session.date && (
								<time
									class="label-mono text-[0.625rem] text-faint md:justify-self-end md:self-start md:pt-1"
									datetime={session.date}
								>
									{session.date}
								</time>
							)}
						</li>
					))}
				</ol>

				{dateNote && (
					<p class="mt-3.5 font-mono text-[0.6875rem] leading-relaxed text-faint">
						{dateNote}
					</p>
				)}
			</>
		) : (
			<p class="border-b border-line-strong py-6 text-[0.8125rem] text-faint">
				No sessions on record yet.
			</p>
		)
	}

	{
		caption && (
			<p class="mt-6 max-w-sm text-[0.8125rem] leading-relaxed text-muted">
				{caption}
			</p>
		)
	}
</section>
