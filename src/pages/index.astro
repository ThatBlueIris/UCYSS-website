---
import Base from "../layouts/Base.astro";
import Wordmark from "../components/Wordmark.astro";

/* Real numbers, not placeholders. Sourced from ~/Documents/UCYSS (PLAN.md §1.3).
   If these change, change them here — this is the point of putting real content
   on the homepage instead of marketing filler. */
const stats = [
	{ value: "41", label: "Members" },
	{ value: "3+", label: "Workshops run" },
	{ value: "MITEC", label: "CyberDSA 2026" },
	{ value: "UPTM", label: "Cyberjaya" },
];

const pillars = [
	{
		tag: "01",
		title: "Hands-on labs",
		body: "Capture-the-flag environments and structured walkthroughs. We run Hack The Box sessions on a fortnightly cadence — bring a laptop.",
	},
	{
		tag: "02",
		title: "Forensics & OSINT",
		body: "Packet analysis, disk imaging, steganography, and open-source intelligence. The technical deep end, taught hands-on.",
	},
	{
		tag: "03",
		title: "Conventions & exposure",
		body: "We take students to national cybersecurity events and bring back what we learn. Industry exposure for people who can't leave campus yet.",
	},
];
---

<Base
	title="UCYSS"
	description="The cybersecurity community within Pixora, FCOM, UPTM. Capture-the-flag labs, digital forensics, OSINT workshops, and convention writeups."
>
	<!-- ================= HERO ================= -->
	<section class="relative overflow-hidden border-b border-line-soft">
		<!-- texture layers: grid below, noise above, watermark faintest -->
		<div class="grid-texture absolute inset-0 opacity-60" aria-hidden="true"></div>
		<div class="noise-texture absolute inset-0 opacity-[0.035]" aria-hidden="true"></div>
		<div class="shield-watermark absolute inset-0 opacity-[0.04]" aria-hidden="true"></div>

		<div
			class="relative mx-auto grid max-w-6xl gap-14 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10 lg:py-32"
		>
			<!-- left: text, aligned to a left margin, not centred -->
			<div class="lg:col-span-7">
				<p class="label-mono text-accent">Pixora &middot; FCOM &middot; UPTM</p>

				<h1
					class="mt-6 text-4xl leading-[1.05] font-light tracking-tight sm:text-5xl lg:text-6xl"
				>
					Pixora is our home.<br />
					<span class="font-semibold text-teal">UCYSS</span> is where we go deep on
					security.
				</h1>

				<p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">
					A student-led cybersecurity community at Universiti Poly-Tech Malaysia. CTF
					labs, digital forensics, OSINT, and writeups from the events we run.
				</p>

				<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
					<a
						href="/join"
						class="inline-flex min-h-12 items-center justify-center bg-teal px-7 text-sm font-semibold text-navy transition-transform duration-200 ease-soft hover:-translate-y-0.5"
					>
						Join UCYSS
					</a>
					<a
						href="/writeups"
						class="inline-flex min-h-12 items-center justify-center border border-line px-7 text-sm text-muted transition-colors duration-200 hover:border-teal hover:text-text"
					>
						Read the writeups
					</a>
				</div>
			</div>

			<!-- right: terminal block. The asymmetry is deliberate. -->
			<div class="lg:col-span-5 lg:pt-16">
				<div
					class="overflow-hidden border border-line bg-ink/60 font-mono text-[0.8rem] leading-relaxed"
				>
					<div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
						<span class="h-2 w-2 bg-line"></span>
						<span class="h-2 w-2 bg-line"></span>
						<span class="h-2 w-2 bg-line"></span>
						<span class="ml-2 text-faint">ucyss — activity</span>
					</div>
					<div class="space-y-1.5 p-4">
						<p><span class="text-teal">$</span> <span class="text-text">ucyss what-we-run</span></p>
						<p class="text-muted">ctf ............ Hack The Box, fortnightly</p>
						<p class="text-muted">forensics ...... pcap, disk images, stego</p>
						<p class="text-muted">osint .......... dorking, SOCMINT, OPSEC</p>
						<p class="text-muted">events ......... conventions &amp; meetups</p>
						<p class="mt-3 text-faint"># bring a laptop. wifi provided.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ================= STATS ================= -->
	<section class="border-b border-line-soft">
		<div
			class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-line-soft px-0 md:grid-cols-4 md:px-8"
		>
			{
				stats.map((s) => (
					<div class="bg-bg px-5 py-8 md:px-6">
						<p class="text-2xl font-light tracking-tight">{s.value}</p>
						<p class="label-mono mt-2 text-faint">{s.label}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- ================= PILLARS ================= -->
	<section class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
		<div class="max-w-2xl">
			<p class="label-mono text-accent">What we do</p>
			<h2 class="mt-5 text-3xl leading-tight font-light tracking-tight md:text-4xl">
				Three things, done properly.
			</h2>
		</div>

		<!-- Editorial list, not a row of three gradient-icon cards (PLAN.md §3.8) -->
		<div class="mt-14 border-t border-line-soft">
			{
				pillars.map((p) => (
					<article class="group grid gap-4 border-b border-line-soft py-9 md:grid-cols-12 md:gap-8">
						<p class="label-mono pt-1 text-faint md:col-span-1">{p.tag}</p>
						<h3 class="text-xl font-medium tracking-tight transition-colors duration-200 group-hover:text-teal md:col-span-4 md:text-2xl">
							{p.title}
						</h3>
						<p class="max-w-xl leading-relaxed text-muted md:col-span-7">{p.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- ================= LATEST ================= -->
	<section class="border-t border-line-soft bg-surface">
		<div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-24">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<p class="label-mono text-accent">Latest</p>
					<h2 class="mt-5 text-3xl leading-tight font-light tracking-tight">
						From the archive
					</h2>
				</div>
				<a
					href="/events"
					class="text-sm text-muted transition-colors hover:text-teal"
				>
					All events &rarr;
				</a>
			</div>

			<!-- Content collections arrive in Phase 3. Until then this states the
			     intent plainly rather than faking entries. -->
			<div class="accent-bar mt-10 border border-line-soft bg-bg p-8 md:p-10">
				<p class="label-mono text-faint">Writeups &amp; events loading</p>
				<p class="mt-3 max-w-lg leading-relaxed text-muted">
					The OSINT workshop, the Hack The Box meetup, and the Digital Forensics
					session are being converted into proper writeups. Real content, not
					placeholders — it's coming from our own records.
				</p>
			</div>
		</div>
	</section>
</Base>
