---
import Base from "../layouts/Base.astro";

/* ---------------------------------------------------------------------------
   Real content, sourced from our own records in ~/Documents/UCYSS. If a number
   changes, change it here — putting real content on the homepage instead of
   marketing filler is the single strongest signal that this site is real.
   --------------------------------------------------------------------------- */
const stats = [
	{ value: "41", label: "Registered members" },
	{ value: "38", label: "Students at CyberDSA 2026" },
	{ value: "4", label: "Forensics lab sets" },
	{ value: "MITEC", label: "Kuala Lumpur" },
];

const pillars = [
	{
		tag: "01",
		title: "Hands-on labs",
		meta: "fortnightly",
		body: "Capture-the-flag machines and structured walkthroughs, on a fortnightly cadence. We open a Hack The Box session, work the boxes in the room, and write up what actually broke. Bring a laptop; spares exist if you don't have one.",
	},
	{
		tag: "02",
		title: "Forensics & OSINT",
		meta: "pcap · disk images · stego",
		body: "The deep end. Packet captures, an NTFS disk image, steganography, and a recon discipline that starts with what you can find out about someone without touching their machine — and stops before it becomes doxxing.",
	},
	{
		tag: "03",
		title: "Conventions & exposure",
		meta: "CyberDSA · CyberSecurity Malaysia",
		body: "We take students to national events and bring back what we learned. 38 students and two adjunct lecturers at CyberDSA 2026. A delegation to CyberSecurity Malaysia in June. This is the part of the job that doesn't fit on a screen.",
	},
];

/* The archive index. Dates, titles and figures are taken from the artefacts
   themselves — meeting minutes, the workshop deck, the ATAP proposal, and the
   forensics lab folder. */
const archive = [
	{
		date: "2026 / 10 / 05",
		kind: "upcoming",
		title: "CyberDSA 2026",
		body: "MITEC, Kuala Lumpur. A national convention on secure AI, digital trust, critical infrastructure and digital forensics — 38 students and 2 adjunct lecturers, run under Pixora's ATAP allocation.",
	},
	{
		date: "2026 / 08 / 28",
		kind: "workshop",
		title: "The Art of OSINT",
		body: "Arif Abd Kahar's 26-slide deck: digital footprint, ethics under Malaysian cyber law, dorking, SOCMINT, GEOINT and TECHINT — closing on a self-audit of your own cooked footprint.",
	},
	{
		date: "2026 / 08 / 05",
		kind: "session",
		title: "Hack The Box, first lab",
		body: "Classroom CR 5.20, 10:30pm. 41 students signed up across all nine semesters, run with Pixora's protocol, technical and media teams.",
	},
	{
		date: "2026 / 06 / 25",
		kind: "visit",
		title: "CyberSecurity Malaysia",
		body: "A morning at Cyberjaya with the UPTM delegation — briefing, questions, and a look at how a national CERT actually operates.",
	},
];
---

<Base
	title="UCYSS"
	description="The cybersecurity focus group within Pixora, FCOM, UPTM. Capture-the-flag labs, digital forensics, OSINT, and writeups from the sessions we run."
>
	<!-- ==================== HERO ==================== -->
	<!-- Asymmetric by design: type on the left, the terminal block on the right.
	     Never a centred headline over two stacked buttons. The deep-space field
	     is a fixed backdrop behind the whole document, so there is nothing to
	     layer here. -->
	<section class="relative border-b border-line">
		<div
			class="mx-auto grid max-w-6xl gap-14 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-10 lg:py-32"
		>
			<div class="lg:col-span-7">
				<p class="label-mono text-accent">Pixora &middot; FCOM &middot; UPTM</p>

				<h1 class="mt-7 max-w-2xl text-display font-light">
					Pixora is our home.
					<span class="font-semibold">UCYSS</span> is where we go deep on security.
				</h1>

				<p class="mt-8 max-w-xl text-lede text-muted">
					A student community at Universiti Poly-Tech Malaysia. We run capture-the-flag
					labs, digital forensics and OSINT sessions on a fortnightly cadence, and we
					publish the writeups.
				</p>

				<div class="mt-11 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
					<!-- Solid white, not teal and not a gradient. The accent is
					     rationed elsewhere; the primary action does not need it. -->
					<a
						href="/join"
						class="inline-flex min-h-12 items-center justify-center bg-text px-7 text-sm font-semibold text-void transition-transform duration-200 ease-out-soft hover:-translate-y-0.5"
					>
						Join UCYSS
					</a>
					<a
						href="/writeups"
						class="inline-flex min-h-12 items-center justify-center border border-line-strong px-7 text-sm text-muted transition-colors duration-200 hover:border-ghost hover:text-text"
					>
						Read the writeups
					</a>
				</div>
			</div>

			<!-- The terminal block. Its job is to say what we actually run, in the
			     idiom our members already live in. -->
			<div class="lg:col-span-5 lg:pt-14">
				<div class="overflow-hidden border border-line bg-surface font-mono">
					<div
						class="flex items-center gap-3 border-b border-line px-4 py-2.5 text-[0.6875rem] text-faint"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
						<span>ucyss &mdash; scope</span>
					</div>

					<div class="space-y-2.5 p-5 text-[0.8125rem] leading-relaxed">
						<p><span class="text-accent">$</span> <span class="text-text">ucyss what-we-run</span></p>
						{
							[
								["parent", "Pixora — FCOM, UPTM"],
								["ctf", "hack the box · fortnightly"],
								["forensics", "pcap · ntfs image · stego"],
								["osint", "dorking · socmint · opsec"],
								["output", "writeups, published openly"],
							].map(([key, value]) => (
								<p class="flex items-baseline gap-2.5">
									<span class="w-[4.5rem] shrink-0 text-text">{key}</span>
									<span class="rule-dots" aria-hidden="true" />
									<span class="text-faint">{value}</span>
								</p>
							))
						}
						<p class="pt-1.5 text-faint">
							<span class="text-accent" aria-hidden="true">$</span>
							<span class="ml-1.5 inline-block h-3.5 w-[0.5rem] translate-y-0.5 bg-accent" aria-hidden="true" />
						</p>
					</div>
				</div>

				<p class="mt-4 max-w-xs text-[0.8125rem] leading-relaxed text-faint">
					Meetings are open to any FCOM student. You do not need to be good at this.
				</p>
			</div>
		</div>
	</section>

	<!-- ==================== STATS ==================== -->
	<!-- Whitespace-separated rather than boxed. Density variation matters more
	     than a tidy table. -->
	<section class="border-b border-line">
		<div class="mx-auto max-w-6xl px-5 md:px-8">
			<dl class="grid grid-cols-2 gap-x-6 gap-y-9 py-11 md:grid-cols-4 md:gap-x-10 md:py-14">
				{
					stats.map((s) => (
						<div>
							<dd class="text-3xl font-light tracking-display text-text md:text-4xl">
								{s.value}
							</dd>
							<dt class="label-mono mt-3 text-faint">{s.label}</dt>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ==================== PILLARS ==================== -->
	<section class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
		<div class="max-w-2xl">
			<p class="label-mono text-accent">What we do</p>
			<h2 class="mt-6 text-title font-light">Three things, done properly.</h2>
		</div>

		<!-- An editorial numbered list. Deliberately not a row of three cards
		     with gradient rounded-square icons (PLAN.md §3.8). -->
		<div class="mt-14 border-t border-line md:mt-16">
			{
				pillars.map((p) => (
					<article class="group grid gap-x-8 gap-y-3 border-b border-line py-9 md:grid-cols-12 md:py-11">
						<p class="label-mono pt-1.5 text-faint transition-colors duration-200 group-hover:text-accent md:col-span-1">
							{p.tag}
						</p>
						<div class="md:col-span-4">
							<h3 class="text-xl font-medium tracking-tight md:text-[1.375rem]">
								{p.title}
							</h3>
							<p class="label-mono mt-3 text-[0.5625rem] text-faint">{p.meta}</p>
						</div>
						<p class="max-w-xl leading-relaxed text-muted md:col-span-7">{p.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- ==================== ARCHIVE ==================== -->
	<!-- The only opaque surface on the page. It earns it: it is where the real
	     material lives, and it carries the constellation treatment. -->
	<section class="border-t border-line bg-surface">
		<div class="constellation">
			<div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-24">
				<div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
					<div>
						<p class="label-mono text-accent">The archive</p>
						<h2 class="mt-6 text-title font-light">What we have actually run</h2>
					</div>
					<a
						href="/writeups"
						class="inline-flex min-h-11 items-center text-sm text-muted transition-colors duration-200 hover:text-text"
					>
						All writeups &rarr;
					</a>
				</div>

				<!-- An index, not a card grid: fixed date column, kind, title, note. -->
				<ol class="mt-12 border-t border-line">
					{
						archive.map((entry) => (
							<li class="grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-12">
								<p class="label-mono pt-1 text-[0.625rem] text-faint md:col-span-2">
									{entry.date}
								</p>
								<p class="label-mono pt-1 text-[0.625rem] text-faint md:col-span-2">
									{entry.kind}
								</p>
								<div class="md:col-span-8">
									<h3 class="text-lg font-medium tracking-tight">{entry.title}</h3>
									<p class="mt-2 max-w-2xl leading-relaxed text-muted">{entry.body}</p>
								</div>
							</li>
						))
					}
				</ol>

				<p class="mt-8 max-w-xl text-[0.9375rem] leading-relaxed text-faint">
					Nothing here is filler. Every entry comes out of our own records, and every
					writeup is checked for leaked credentials, real target infrastructure and
					other people's personal data before it goes up.
				</p>
			</div>
		</div>
	</section>
</Base>
