---
import Base from "../layouts/Base.astro";
import SessionLog from "../components/SessionLog.astro";
import { activityLog, ctfNames, figures } from "../data/site";

/* Every number on this page comes from src/data/site.ts. Nothing is written
   into the markup, so changing the member count or adding a session is a
   one-file job for whoever holds the repository. */
const stats = [
	{ value: figures.members.value, label: figures.members.label },
	{
		value: figures.sessionsRun.value,
		label: figures.sessionsRun.label,
		approximate: figures.sessionsRun.approximate,
	},
	{ value: figures.ctfsEntered.value, label: figures.ctfsEntered.label },
	{ value: figures.meetupCadence.value, label: figures.meetupCadence.label },
];

const pillars = [
	{
		tag: "01",
		title: "Weekly sharing sessions",
		meta: "member-led · one topic per week",
		body: "One member signs up to teach something they picked up recently, and everyone else comes to learn it. The topic changes every week and is deliberately varied — OSINT, web exploitation with Burp Suite, and Linux for beginners have all been on. Nobody is expected to know anything beforehand.",
	},
	{
		tag: "02",
		title: "The CTF team",
		/* Read from the data module so the two lists cannot drift apart. */
		meta: ctfNames.join(" · ").toLowerCase(),
		body: "We enter competitions as a group rather than as individuals. UPTM backs SunCTF with transport money; the rest we pay for ourselves. Afterwards, if the team wants it, we sit down together and go through how each flag was actually got — the method, the steps, the dead ends. That conversation is the point, not a report anyone writes.",
	},
	{
		tag: "03",
		title: "Conventions and external meetups",
		meta: "cybersecurity malaysia · external meetups",
		body: "We attend conventions and other communities' meetups, then bring back what was worth hearing and teach it in a session. It is a small part of the year, and it is how most of what we know got into the room in the first place.",
	},
];
---

<Base
	title="UCYSS"
	description="A cybersecurity community at UPTM where members teach each other, almost every week. Beginner-first sharing sessions, and a CTF team that competes together."
>
	<!-- ==================== HERO ==================== -->
	<!-- Asymmetric by design: type on the left, the session log on the right.
	     Never a centred headline over two stacked buttons. The deep-space field
	     is a fixed backdrop behind the whole document, so there is nothing to
	     layer here. -->
	<section class="relative border-b border-line">
		<div
			class="mx-auto grid max-w-6xl gap-14 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-10 lg:py-32"
		>
			<div class="lg:col-span-7">
				<p class="label-mono text-accent">Pixora &middot; FCOM &middot; UPTM</p>

				<!-- {" "} keeps a real space where the line breaks: Astro collapses the
				     whitespace between text and the span, and "teachessomething" is
				     not a word. -->
				<h1 class="mt-7 max-w-2xl text-display font-light">
					Every week, a member teaches{" "}
					<span class="font-semibold">something they learned recently</span>.
				</h1>

				<p class="mt-8 max-w-xl text-lede text-muted">
					A student community at Universiti Poly-Tech Malaysia. One member picks the topic
					and teaches it; the rest of us turn up, ask questions and take notes. Most people
					arrive knowing very little, which is why it works that way.
				</p>

				<div class="mt-11 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
					<!-- Solid white, not teal and not a gradient. The accent is
					     rationed elsewhere; the primary action does not need it. -->
					<a
						href="/join"
						class="inline-flex min-h-12 items-center justify-center bg-text px-7 text-sm font-semibold text-void transition-transform duration-200 ease-out-soft hover:-translate-y-0.5"
					>
						Join UCYSS
					</a>
					<a
						href="/what-we-do"
						class="inline-flex min-h-12 items-center justify-center border border-line-strong px-7 text-sm text-muted transition-colors duration-200 hover:border-ghost hover:text-text"
					>
						How a week works
					</a>
				</div>
			</div>

			<!-- What we actually run, taken from the record. Deliberately not a
			     terminal: a fake `$` prompt is meta for every cybersecurity site
			     on the internet, and this one is meant to look like an archive. -->
			<div class="lg:col-span-5 lg:pt-14">
				<SessionLog
					caption="Anyone in the room can teach the next one — being new to security is not a reason to wait."
				/>
			</div>
		</div>
	</section>

	<!-- ==================== STATS ==================== -->
	<!-- Whitespace-separated rather than boxed. Density variation matters more
	     than a tidy table. -->
	<section class="border-b border-line">
		<div class="mx-auto max-w-6xl px-5 md:px-8">
			<dl class="grid grid-cols-2 gap-x-6 gap-y-9 py-11 md:grid-cols-4 md:gap-x-10 md:py-14">
				{
					stats.map((s) => (
						<div>
							<dd class="text-3xl font-light tracking-display text-text md:text-4xl">
								{"approximate" in s && s.approximate ? "~" : ""}
								{s.value}
							</dd>
							<dt class="label-mono mt-3 text-faint">{s.label}</dt>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- ==================== WHAT WE DO ==================== -->
	<section class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
		<div class="max-w-2xl">
			<p class="label-mono text-accent">What we do</p>
			<h2 class="mt-6 text-title font-light">Three things, and that is the whole list.</h2>
		</div>

		<!-- An editorial numbered list. Deliberately not a row of three cards
		     with gradient rounded-square icons (PLAN.md §3.8). -->
		<div class="mt-14 border-t border-line md:mt-16">
			{
				pillars.map((p) => (
					<article class="group grid gap-x-8 gap-y-3 border-b border-line py-9 md:grid-cols-12 md:py-11">
						<p class="label-mono pt-1.5 text-faint transition-colors duration-200 group-hover:text-accent md:col-span-1">
							{p.tag}
						</p>
						<div class="md:col-span-4">
							<h3 class="text-xl font-medium tracking-tight md:text-[1.375rem]">
								{p.title}
							</h3>
							<p class="label-mono mt-3 text-[0.5625rem] text-faint">{p.meta}</p>
						</div>
						<p class="max-w-xl leading-relaxed text-muted md:col-span-7">{p.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- ==================== ARCHIVE ==================== -->
	<!-- The only opaque surface on the page. It earns it: it is where the real
	     material lives, and it carries the constellation treatment. -->
	<section class="border-t border-line bg-surface">
		<div class="constellation">
			<div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-24">
				<div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
					<div>
						<p class="label-mono text-accent">The archive</p>
						<h2 class="mt-6 text-title font-light">What we have actually run</h2>
					</div>
					<a
						href="/writeups"
						class="inline-flex min-h-11 items-center text-sm text-muted transition-colors duration-200 hover:text-text"
					>
						All writeups &rarr;
					</a>
				</div>

				<!-- An index, not a card grid: fixed date column, kind, title, note.
				     The entries live in src/data/site.ts so the archive is editable
				     in the same place as the member count. -->
				<ol class="mt-12 border-t border-line">
					{
						activityLog.map((entry) => (
							<li class="grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-12">
								<p class="label-mono pt-1 text-[0.625rem] text-faint md:col-span-2">
									{entry.date || "date to add"}
								</p>
								<p class="label-mono pt-1 text-[0.625rem] text-faint md:col-span-2">
									{entry.kind}
								</p>
								<div class="md:col-span-8">
									<h3 class="text-lg font-medium tracking-tight">{entry.title}</h3>
									{entry.body && (
										<p class="mt-2 max-w-2xl leading-relaxed text-muted">{entry.body}</p>
									)}
								</div>
							</li>
						))
					}
				</ol>

				<p class="mt-8 max-w-xl text-[0.9375rem] leading-relaxed text-faint">
					Every entry here came out of something that actually happened. The writeups are
					members' own notes on what they worked through — written by whoever ran the
					session, in their own words, and left up as they were written.
				</p>
			</div>
		</div>
	</section>
</Base>
